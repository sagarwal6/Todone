# Gemini API (for AI research features)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API (for agentic features)
# Use TODONE_ANTHROPIC_API_KEY to avoid conflict with Claude Code's env var
TODONE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily API (for web search)
# Get from https://tavily.com - free tier available
TAVILY_API_KEY=your_tavily_api_key_here

# Google OAuth
# Get these from console.cloud.google.com > APIs & Services > Credentials
# Required scopes: email, profile, Gmail API, Calendar API
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Supabase (Server-side)
# Get these from your Supabase project settings > API
SUPABASE_URL=your_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase (Client-side - public keys)
NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Encryption (for encrypting OAuth tokens at rest)
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=generate_with_openssl_rand_base64_32

# User Location (for local searches - restaurants, services, etc.)
# The agent will use this to contextualize local searches
DEFAULT_USER_LOCATION=San Francisco, CA
